# Server-side only. Configure at least one provider in Vercel Project Settings.
# NEVER prefix an AI secret with VITE_.
AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk_REPLACE_ME
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional alternative provider. Set AI_PROVIDER=openai to make it primary.
# OPENAI_API_KEY=sk_REPLACE_ME
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_REALTIME_VOICE=alloy
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# The serverless AI functions can reuse the same public Supabase values that
# are already configured for the frontend. These are not service-role secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Development-only escape hatch for running the serverless functions without
# server-side Supabase variables. Keep this false/absent in production.
# ALLOW_CLIENT_SUPABASE_CONFIG=false

# Recommended for a personal deployment: only these Supabase user UUIDs may use paid AI.
# AISH_AMAN_ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000000
