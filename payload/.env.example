# Server-side only. Configure these in Vercel Project Settings -> Environment Variables.
# NEVER prefix this secret with VITE_.
DEEPSEEK_API_KEY=sk_REPLACE_ME

# Optional. The cloud bridge defaults to deepseek-v4-flash.
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# The serverless AI functions can reuse the same public Supabase values that
# are already configured for the frontend. These are not service-role secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Recommended for a personal deployment: only these Supabase user UUIDs may use paid AI.
# AISH_AMAN_ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000000
