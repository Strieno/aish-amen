{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/cloud?route=chat"
    },
    {
      "source": "/api/chat/stream",
      "destination": "/api/cloud?route=chat-stream"
    },
    {
      "source": "/api/ai/action",
      "destination": "/api/cloud?route=ai-action"
    },
    {
      "source": "/api/ai/assist/stream",
      "destination": "/api/cloud?route=ai-assist-stream"
    },
    {
      "source": "/api/ai/breakdown",
      "destination": "/api/cloud?route=ai-breakdown"
    },
    {
      "source": "/api/ai/propose",
      "destination": "/api/cloud?route=ai-propose"
    },
    {
      "source": "/api/ai/status",
      "destination": "/api/cloud?route=ai-status"
    },
    {
      "source": "/api/ai/suggest",
      "destination": "/api/cloud?route=ai-suggest"
    },
    {
      "source": "/api/ai/tts",
      "destination": "/api/cloud?route=ai-tts"
    },
    {
      "source": "/api/ai/realtime/call",
      "destination": "/api/cloud?route=ai-realtime-call"
    },
    {
      "source": "/api/conversations/:id/categorize",
      "destination": "/api/cloud?route=conversation-categorize&id=:id"
    },
    {
      "source": "/api/links/discover",
      "destination": "/api/cloud?route=links-discover"
    },
    {
      "source": "/api/providers/:id/test",
      "destination": "/api/cloud?route=provider-test&id=:id"
    }
  ]
}
